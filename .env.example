# ── PocketBase ────────────────────────────────────────────────────
EXPO_PUBLIC_POCKETBASE_URL=https://your-pb-instance.fly.dev
NEXT_PUBLIC_POCKETBASE_URL=https://your-pb-instance.fly.dev
PB_ENCRYPTION_KEY=changeme32charslong!

# ── Cloudflare ────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# ── Resend (email) ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxxx
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxxx
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxxx

# ── Expo / EAS ────────────────────────────────────────────────────
EXPO_TOKEN=your_expo_token
EXPO_ACCESS_TOKEN=your_expo_access_token_optional

# ── AMap (Gaode) ─────────────────────────────────────────────────
NEXT_PUBLIC_AMAP_KEY=your_amap_key
NEXT_PUBLIC_AMAP_SECURITY_KEY=your_amap_security_key
EXPO_PUBLIC_AMAP_KEY_ANDROID=your_amap_android_key
EXPO_PUBLIC_AMAP_KEY_IOS=your_amap_ios_key

# ── Setup ─────────────────────────────────────────────────────────
SETUP_SECRET=your_setup_secret_token
