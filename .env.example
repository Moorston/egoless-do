# ─── 环境变量模板 ──────────────────────────────────────────────────
# 复制此文件为 .env 并填写实际值。
# 不要提交 .env 到 git（已在 .gitignore 中）。
# ──────────────────────────────────────────────────────────────────

# ─── PocketBase ──────────────────────────────────────────────────
# 服务端 API 地址（docker-compose 内网用 http://pocketbase:8090）
PB_URL=http://localhost:8090
PB_ADMIN_EMAIL=admin@egoless.do
PB_ADMIN_PASSWORD=change-me
# AES-256 加密密钥，用于本地数据加密（必须 32 字符）
PB_ENCRYPTION_KEY=change-me-to-32-characters-long!

# ─── Auth API 服务间认证 ──────────────────────────────────────────
# 用于 Auth API 与 PocketBase hook 之间的内部请求认证
# 如果未设置，尝试使用 PB_ENCRYPTION_KEY。生产环境必须单独设置！
INTERNAL_SECRET=change-me-to-32-characters-long!

# ─── SMTP 邮件配置 ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.com

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_FILE=/tmp/rate-limit-state.json

# ─── 微信登录（可选）──────────────────────────────────────────────
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# ─── 公开访问地址 ─────────────────────────────────────────────────
EXPO_PUBLIC_PB_URL=https://your-pb-instance.fly.dev
EXPO_PUBLIC_API_URL=https://your-api-instance.fly.dev

# ─── Cloudflare Tunnel（可选）────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# ─── Resend 邮件（可选）───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── Sentry ───────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxxx
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxxx

# ─── Expo / EAS ──────────────────────────────────────────────────
EXPO_TOKEN=your_expo_token
EXPO_ACCESS_TOKEN=your_expo_access_token_optional

# ─── AMap 高德地图 ───────────────────────────────────────────────
EXPO_PUBLIC_AMAP_KEY_ANDROID=your_amap_android_key
EXPO_PUBLIC_AMAP_KEY_IOS=your_amap_ios_key

# ─── Setup ────────────────────────────────────────────────────────
SETUP_SECRET=your_setup_secret_token

# ─── Docker Compose ───────────────────────────────────────────────
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=your-secure-password
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password